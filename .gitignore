# Caches compilados de Laravel — NUNCA se versionan, se regeneran en el
# entrypoint/build. Si estos quedan en el repo con rutas/config viejas
# de tu máquina, el contenedor arranca roto.
/bootstrap/cache/*.php
!/bootstrap/cache/.gitignore
